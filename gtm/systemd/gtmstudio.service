[Unit]
Description=GTM Slide Pack Studio API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/sentimentpulse/gtm/backend
EnvironmentFile=-/etc/gtm/.env
Environment=GTM_DB_PATH=/var/lib/gtm/db.sqlite
Environment=GTM_STORAGE_ROOT=/var/lib/gtm
ExecStart=/opt/sentimentpulse/gtm/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001 --workers 1
Restart=on-failure
RestartSec=5
# Constrain memory so the renderer can't OOM the whole droplet
MemoryHigh=750M
MemoryMax=900M

[Install]
WantedBy=multi-user.target
