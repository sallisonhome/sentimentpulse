# ── Reddit API ────────────────────────────────────────────────────────────────
# Register an app at https://www.reddit.com/prefs/apps (script type)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SentimentPulse/1.0 by YourRedditUsername

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank to use SQLite (sentimentpulse.db in the backend directory)
# PostgreSQL example: postgresql://user:password@localhost:5432/sentimentpulse
DATABASE_URL=

# ── Optional defaults ─────────────────────────────────────────────────────────
# Pre-seed the publisher name so the app is ready on first launch
PUBLISHER_NAME=
