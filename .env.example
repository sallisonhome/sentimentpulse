# ── Reddit ────────────────────────────────────────────────────────────────────
# No Reddit API credentials needed — the app uses Reddit's public JSON feeds.
# The fields below are kept for reference but are not used.
REDDIT_USER_AGENT=SentimentPulse/1.0

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank to use SQLite (sentimentpulse.db in the backend directory)
# PostgreSQL example: postgresql://user:password@localhost:5432/sentimentpulse
# DATABASE_URL=  # Omit or leave blank for SQLite; set to postgresql://... for Postgres

# ── Optional defaults ─────────────────────────────────────────────────────────
# Pre-seed the publisher name so the app is ready on first launch
PUBLISHER_NAME=

# Optional: also search Steam by developer name.
# Useful when the studio is both developer AND publisher, or when games are
# published under a third-party label (e.g. Focus Home Interactive).
DEVELOPER_NAME=

# ── Lightweight mode ──────────────────────────────────────────────────────────
# Set to true on servers with < 4 GB RAM. Skips PyTorch/transformers/BERTopic
# and uses VADER + LDA instead. Install requirements-light.txt when enabled.
LIGHTWEIGHT_NLP=false
