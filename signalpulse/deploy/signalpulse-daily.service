[Unit]
Description=SignalPulse daily refresh (signal collection + revenue anchors + estimator)
Wants=network-online.target
After=network-online.target signalpulse.service

[Service]
Type=oneshot
# ExecStart delegates to a real script file (deploy/signalpulse-daily.sh).
# All quoting/escaping lives there — the previous inline shell chain kept
# tripping systemd's argument parser (INVALIDARGUMENT / exit 2) whenever the
# unit was reloaded from a slightly different source tree.
#
# ExecStartPre resolves the deployed script path from signalpulse.service's
# WorkingDirectory so this unit does NOT hard-code /opt/sentimentpulse.
ExecStart=/bin/sh -c 'WD=$(systemctl show -p WorkingDirectory --value signalpulse); [ -n "$WD" ] || exit 1; exec "$WD/deploy/signalpulse-daily.sh"'
StandardOutput=journal
StandardError=journal
# 20-minute hard cap. Individual phases in the wrapper have their own
# per-phase timeout guards; this is the last-resort ceiling.
TimeoutStartSec=1200
# A bad run should NOT block tomorrow's scheduled fire.
Restart=no

[Install]
WantedBy=multi-user.target
